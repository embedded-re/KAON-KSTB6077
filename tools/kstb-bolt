#!/usr/bin/env python3
"""Get the KSTB6077 to the BOLT> prompt by cancelling autostart with Ctrl-C.

BOLT checks the console for Ctrl-C right after its banner and prints
"Automatic startup canceled via Ctrl-C". Sending Ctrl-C continuously while
the board boots always hits that window, so no front-panel button is needed.

    kstb-bolt              wait for a boot (power-cycle the board now), cancel autostart
    kstb-bolt --reset      board is at BOLT>: software-reset it, then cancel autostart
    kstb-bolt --timeout 600

Needs the kstb-bridge service (socket /tmp/kstb.sock, override with KSTB_SOCK).
Exit status: 0 = at BOLT>, 1 = autostart ran (STARTUP / Linux), 2 = timeout.
"""
import argparse, os, re, socket, sys, time

SOCK = os.environ.get("KSTB_SOCK", "/tmp/kstb.sock")
CANCELED = b"Automatic startup canceled"
TOO_LATE = (b"Executing STARTUP", b"Booting Linux")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--reset", action="store_true", help="board is at BOLT>: software-reset it first")
    ap.add_argument("--timeout", type=float, default=300, help="seconds to wait for a boot (default 300)")
    a = ap.parse_args()

    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    s.settimeout(0.03)

    if a.reset:
        # SUN_TOP_CTRL software master reset: enable the source, then trigger.
        s.sendall(b"e -w 0xf0404304 00000001\r")
        time.sleep(0.5)
        s.sendall(b"e -w 0xf0404308 00000001\r")
    else:
        print("waiting for the board to boot - power-cycle it now", flush=True)

    buf, end = b"", time.time() + a.timeout
    while time.time() < end:
        s.sendall(b"\x03")
        try:
            chunk = s.recv(65536)
            if chunk:
                buf += chunk
        except socket.timeout:
            pass
        if CANCELED in buf:
            time.sleep(0.5)
            s.sendall(b"\r")
            time.sleep(0.5)
            rr = re.findall(rb"RR:([0-9a-fA-F]{8})", buf)
            print(f"autostart canceled, board at BOLT> (reset reason RR:{rr[-1].decode() if rr else '?'})")
            return 0
        if any(t in buf for t in TOO_LATE):
            print("too late: autostart already ran (STARTUP / Linux)", file=sys.stderr)
            return 1
    print("timeout: no boot seen", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
